#include <bits/stdc++.h>
using namespace std;
int main() {
    // Write C++ code here
    int n;
    cin>>n;
    vector<int>a(n);
    for(int i=0;i<n;i++){
        cin>>a[i];
    }
    int lar=0;
    int sam=a[0];
    for(int i=0;i<n;i++){
        if(a[i]>lar){
            lar=a[i];
        }
        if(a[i]<sam){
            sam=a[i];
        }
    }
    cout<<lar<<" "<<sam<<endl;
    return 0;
}
