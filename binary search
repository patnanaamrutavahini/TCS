#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, key;
    cin >> n;
    vector<int> a(n);
    for(int i = 0; i < n; i++) {
        cin >> a[i];
    }
    cin >> key;
    sort(a.begin(), a.end());
    int start = 0, end = n - 1;
    while(start <= end) {
        int mid = (start + end) / 2;
        if(a[mid] == key) {
            cout << "Found at position " << mid + 1;
            return 0;
        }
        else if(a[mid] < key) {
            start = mid + 1;
        }
        else {
            end = mid - 1;
        }
    }
    cout << "Not Found";
    return 0;
}
