#include <iostream>
using namespace std;
bool isprime(int n){
    int count=0;
    for(int i=1;i<=n;i++){
        if(n%i==0){
            count++;
        }
    }
    return (count==2);
}
int main() {
    int n;
    cin>>n;
    if(isprime(n)) cout<<"Prime Number\n";
    else cout<<"Not Prime Number\n";
    return 0;
}
