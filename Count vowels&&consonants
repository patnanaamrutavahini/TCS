#include <bits/stdc++.h>
using namespace std;
int main() {
    // Write C++ code here
    string s;
    cin>>s;
    // vowels: a,e,i,o,u
    int start=0;
    int count1=0,count2=0;
    for(int i=0;i<s.length();i++){
        if(s[start]=='a'||s[start]=='e'||s[start]=='i'||s[start]=='o'||s[start]=='u'){
            count1++;
        }else{
            count2++;
        }
        start++;
    }
    cout<<"vowels:"<<count1<<endl;
    cout<<"consonants:"<<count2<<endl;
    return 0;
}
