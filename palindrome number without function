#include <iostream>
using namespace std;

int main() {
    int n,temp,rev=0,digit;
    cin>>n;
    temp=n;
    while(n>0){
        digit=n%10;
        rev=rev*10+digit;
        n=n/10;
    }
    if(temp==rev) cout<<"Palindrome Number\n";
    else cout<<"Not Palindrome Number\n";
    
    return 0;
}
