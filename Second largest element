#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    vector<int>nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int lar=nums[0];
    int sec=0;
    for(int i=1;i<n;i++){
        if(nums[i]>lar){
            sec=lar;
            lar=nums[i];
        }
        else if(nums[i]>sec&&nums[i]!=lar){
            sec=nums[i];
        }
    }
    
    cout<<sec<<endl;

    return 0;
}
