#include <bits/stdc++.h>
using namespace std;

int f(int n, int f1, int f2) {
    if(n == 0) {
        cout << 0;
        return 0;
    }
    cout << f1 << " ";
    if(n > 1)
        cout << f2 << " ";
    for(int i = 2; i < n; i++) {
        int c = f1 + f2;
        cout << c << " ";
        f1 = f2;
        f2 = c;
    }
    return 0;
}
int main() {
    int n, f1 = 0, f2 = 1;
    cin >> n;
    f(n, f1, f2);
    return 0;
}
