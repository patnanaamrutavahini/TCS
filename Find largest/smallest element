#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    vector<int>nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int lar=0;
    int sam=nums[0];
    for(int i=0;i<n;i++){
        if(nums[i]>lar){
            lar=nums[i];
        }
        if(nums[i]<sam){
            sam=nums[i];
        }
    }
    cout <<lar<<" "<<sam<<endl;

    return 0;
}
