#include <bits/stdc++.h>
using namespace std;
int main() {
    // Write C++ code here
    string s;
    cin>>s;
    
    string temp=s;
    int start=0;
    int end=temp.length()-1;
    while(start<end){
        swap(temp[start],temp[end]);
        start++;
        end--;
    }
    if(s==temp) cout <<"palindome string";
    else cout<<"not palindome string";

    return 0;
}
